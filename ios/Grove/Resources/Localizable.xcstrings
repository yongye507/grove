    },
    "If this policy changes, we will update the “Last updated” date in the app. Continued use after an update means you accept the revised policy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this policy changes, we will update the “Last updated” date in the app. Continued use after an update means you accept the revised policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果本政策有变更，我们会在 App 内更新“最后更新”日期。更新后继续使用即表示你接受修订后的政策。"
          }
        }
      }
    },
    "If you allow notifications, Grove may schedule a local alert when a focus session is due to finish. Notification permission is optional and managed in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow notifications, Grove may schedule a local alert when a focus session is due to finish. Notification permission is optional and managed in iOS Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你允许通知，Grove 会在专注计时即将结束时安排一条本地提醒。通知权限是可选的，可在 iOS 设置中管理。"
          }
        }
      }
    },
