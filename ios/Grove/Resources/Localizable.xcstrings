    },
    "Lifetime unlock is processed by Apple through StoreKit / App Store. Apple handles payment details under Apple’s privacy policy. Grove only receives an entitlement signal that you own the product so locked trees and Month/Year stats can unlock on this device (and restore on your other devices signed into the same Apple ID).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime unlock is processed by Apple through StoreKit / App Store. Apple handles payment details under Apple’s privacy policy. Grove only receives an entitlement signal that you own the product so locked trees and Month/Year stats can unlock on this device (and restore on your other devices signed into the same Apple ID)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身版解锁由 Apple 通过 StoreKit / App Store 处理。支付信息由 Apple 依据其隐私政策处理。Grove 只会收到“你已拥有该商品”的权益信号，用于在本设备上解锁锁定的树种以及月、年统计（并可在登录同一 Apple ID 的其他设备上恢复）。"
          }
        }
      }
    },
