    "Grove does not target children for data collection. The app does not knowingly collect personal information from children.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove does not target children for data collection. The app does not knowingly collect personal information from children."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove 不以儿童为对象收集数据。本 App 不会有意收集儿童的个人信息。"
          }
        }
      }
    },
    "Grove is a focus timer that grows a tree while you stay present. We designed Grove to work without an account and without tracking you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove is a focus timer that grows a tree while you stay present. We designed Grove to work without an account and without tracking you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove 是一款专注计时器：你保持专注，树就会一点点长大。我们让 Grove 无需账号即可使用，也不会追踪你。"
          }
        }
      }
    },
