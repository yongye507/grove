{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id125354772"}, "name":{"label":"Romaaiiin"}, "label":""}, "updated":{"label":"2026-10-26T05:54:39-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"6.26.420"}, "id":{"label":"14713531145"}, "title":{"label":"Needs fixing"}, "content":{"label":"What’s the point of tracking sleep statistics if the app needs at least 3-4 hours of sleep per day during regular sleep hours or else it doesn’t register anything?! I go out on weekends and go to bed late and don’t sleep enough for the app to work accurately. My short nights get discarded so the overall stats make no sense!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=320606217&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
