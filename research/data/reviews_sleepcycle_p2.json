{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id251291450"}, "name":{"label":"Prootwadl"}, "label":""}, "updated":{"label":"2026-10-19T09:29:44-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"6.26.410"}, "id":{"label":"14686092987"}, "title":{"label":"The sleep aid default is obnoxious"}, "content":{"label":"Instead of defaulting to a sleep aid that I actually use, it defaults to some spoken word thing that has absolutely no utility for me. I cannot listen to voices and fall asleep. I need some sort of constant ambient sound. I wish the app would be smart enough to realize what I actually use and stop defaulting to something that has no value to me whatsoever. I’ve considered stopping this app simply because of this feature. I do not care about the lighthouse. Please stop defaulting to it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=320606217&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id33412848"}, "name":{"label":"KellsMX"}, "label":""}, "updated":{"label":"2026-10-19T06:19:45-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"6.26.410"}, "id":{"label":"14685453928"}, "title":{"label":"Recent issues"}, "content":{"label":"I’ve owned this app for 10 years and rely on it.  But recently, it has had all sorts of problems. This morning when I woke up it was showing me the nights data from august 2024. The recent issues are really getting ridiculous. Time to look for another option", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=320606217&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
