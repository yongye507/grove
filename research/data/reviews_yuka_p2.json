{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1021291324"}, "name":{"label":"hessbess"}, "label":""}, "updated":{"label":"2026-10-16T10:02:55-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"5.8"}, "id":{"label":"14674194841"}, "title":{"label":"Unsuccessful"}, "content":{"label":"So this program seems very ineffective the products that I scanned are not in the system. It takes time for me to scan the product front back sides nutritional information, etc. so I’m actually building their program. Out of the products I’ve scanned. I’ve had to spend my time instead of getting a straightforward answer of healthy or not healthy or getting new recommendations. Program needs to be built before it’s launched.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1092799236&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
