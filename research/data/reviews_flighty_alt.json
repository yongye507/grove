{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id444874196"}, "name":{"label":"Avoid Netflix"}, "label":""}, "updated":{"label":"2026-11-19T14:17:41-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.12.1"}, "id":{"label":"14810261550"}, "title":{"label":"My Favorite App in the World"}, "content":{"label":"I am a mobile product manager and this is the app I state as my favorite mobile app in job interviews as it is an incredibly well designed app that helps deliver live flight information, personal flight logs, and fun statistics all in an incredibly well designed and intuitive user experience. For any aviation nerds like myself this will soon become one of your most beloved apps and I love the new feature where you can see your Flighty Friends passport and flight statistics. Keep up the great work you ex-Apple geniuses!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1358823008&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
