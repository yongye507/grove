{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id720252756"}, "name":{"label":"tinajessel"}, "label":""}, "updated":{"label":"2026-11-05T13:17:19-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"26.44.0"}, "id":{"label":"14755145799"}, "title":{"label":"I love this app"}, "content":{"label":"Having several health conditions, this app is most helpful to keep track of especially my protein levels and vitamin levels. Gastric bypass patients should really focus on proteins and this really helps. Also it adjust to your activities so if you burn more calorie  you know to eat more proteins and reminds you to drink water. A perfect way to put your recipes in and get all the nutrient values on those also. Please quit changing the app. It’s not broken don’t try to fix it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=341232718&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
