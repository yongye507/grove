{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id580583095"}, "name":{"label":"Sparks325"}, "label":""}, "updated":{"label":"2026-11-03T17:49:21-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"26.44.0"}, "id":{"label":"14748001403"}, "title":{"label":"Used to be great….."}, "content":{"label":"Had a pretty good experience using this app. The easy logging makes tracking meals a breeze. The greatest feature WAS the meal scan. Just take a picture of your plate and their AI told you what you ate and the calories consumed. \nMFP pulled the feature without notice.\nI contacted “help” with no response.\nThink before you invest $$$ there might be better options", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=341232718&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
