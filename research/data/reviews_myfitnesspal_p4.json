{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id33798524"}, "name":{"label":"Fun Run Enthusiast"}, "label":""}, "updated":{"label":"2026-11-05T11:39:07-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"26.44.0"}, "id":{"label":"14754875149"}, "title":{"label":"Boo"}, "content":{"label":"Myfitnesspal used to be so easy to use. Now, it is confusing and has even more things behind a paywall. I used to be able to scan a barcode whether free or premium. Not anymore. \n\nThis interface is the most confusing app I have ever dealt with making the simple task of attempting to add a meal, complicated.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=341232718&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
