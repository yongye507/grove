{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id101324148"}, "name":{"label":"Need my breadsticks"}, "label":""}, "updated":{"label":"2026-10-22T11:49:28-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"26.42.0"}, "id":{"label":"14698324430"}, "title":{"label":"Great app for Calorie tracking and weight loss"}, "content":{"label":"Cal AI has been a game changer for me! I’ve lost 50 pounds using this app, and it’s made tracking my food and staying accountable so much easier. I love how simple and convenient it is to use. It’s helped me build better habits and stay consistent without feeling overwhelmed. Definitely worth it!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=6480417616&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
